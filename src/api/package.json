{
  "name": "@adoptierlieber/api",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --port 3000 --env-file ../../.env",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "check": "tsc --noEmit",
    "db:generate": "bun run drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply adoptierlieber --remote",
    "db:migrate:staging": "wrangler d1 migrations apply adoptierlieber-staging --remote --env staging",
    "db:migrate:local": "wrangler d1 migrations apply adoptierlieber --local"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.2",
    "nodemailer": "^9.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "drizzle-kit": "^0.31.10"
  }
}
