{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "adoptierlieber-web",
	"compatibility_date": "2026-08-14",
	"compatibility_flags": ["nodejs_als"],
	"observability": {
		"enabled": false,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true,
		},
		"traces": {
			"enabled": false,
			"persist": true,
			"head_sampling_rate": 1,
		},
	},
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare",
	},
	// Only the custom domains below: no *.workers.dev route or version preview
	// URLs that would bypass the zone's WAF/rules. Repeated per env on purpose.
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{
			"pattern": "adoptierlieber.de",
			"custom_domain": true,
		},
		{
			"pattern": "www.adoptierlieber.de",
			"custom_domain": true,
		},
	],
	"vars": {
		"PUBLIC_API_URL": "https://api.adoptierlieber.de",
		"PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAFSl1zboe_x5xMIF",
	},
	"env": {
		"staging": {
			"name": "adoptierlieber-web-staging",
			"workers_dev": false,
			"preview_urls": false,
			"observability": {
				"enabled": false,
				"head_sampling_rate": 1,
				"logs": {
					"enabled": true,
					"head_sampling_rate": 1,
					"persist": true,
					"invocation_logs": true,
				},
				"traces": {
					"enabled": false,
					"persist": true,
					"head_sampling_rate": 1,
				},
			},
			"routes": [
				{
					"pattern": "staging.adoptierlieber.de",
					"custom_domain": true,
				},
			],
			"vars": {
				"BASIC_AUTH_USER": "staging",
				"PUBLIC_API_URL": "https://api.staging.adoptierlieber.de",
				"PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAFSl1zboe_x5xMIF",
			},
		},
	},
}
