NODE_ENV=development
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
PUBLIC_API_URL=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:5173

SECRET_SMTP_HOST=localhost
SECRET_SMTP_PORT=1025
SECRET_SMTP_USER=
SECRET_SMTP_PASS=
SECRET_SMTP_FROM=Adoptier Lieber <dev@localhost>
SECRET_CONTACT_TO=
SECRET_GEOAPIFY=
# Upstream Geoapify calls per UTC day; cache hits are free. Empty = 2500, below the free tier's
# 3,000 credits/day at one credit per lookup; 0 turns lookups off. Once spent, place search
# reports "unavailable" and users save their place by hand (coordinates follow via the cron).
# Deployed: a var in src/api/wrangler.jsonc or `wrangler secret put GEOAPIFY_DAILY_BUDGET`.
GEOAPIFY_DAILY_BUDGET=
# Development only: send lookups to a local mock instead (loopback hosts only), e.g.
# http://127.0.0.1:3378/v1/geocode/. Deployed builds ignore it.
GEOAPIFY_BASE_URL=
SUPER_ADMIN_EMAIL=
# 32 raw bytes, base64 (or 32/64-byte hex). Durable — losing it locks every TOTP login.
SECRET_TOTP_KEY=
# Shared secret between the web worker's /api proxy and the API. It proves the X-Forwarded-For
# the proxy sets, so API rate limits key on the real client and direct api.* hits cannot pick
# their own bucket. Same value on both workers; empty = legacy behaviour (XFF trusted, warning
# logged). Deployed workers use a secret, not this file: set it on the web worker first, then
# the API (`wrangler secret put PROXY_SECRET` in src/web and src/api, again with --env staging).
PROXY_SECRET=
# Cloudflare Turnstile (bot check) on registration, the contact/support form and password-reset
# requests. Both empty = off: no widget, no check. Two keys, two workers:
# - PUBLIC_TURNSTILE_SITE_KEY: the widget's site key. Public by design (it ships in the page), read
#   by the WEB worker only. `vite dev` reads it from this file; deployed, it is a var in
#   src/web/wrangler.jsonc (top level and env.staging), not a secret.
# - SECRET_TURNSTILE_SECRET: the widget's secret key. API worker only, never on the web worker,
#   never committed. `wrangler dev` reads it from this file; deployed: `wrangler secret put
#   SECRET_TURNSTILE_SECRET` in src/api, again with --env staging.
# Rollout order: deploy the web worker (site key) first, then set the secret. A secret without a
# widget makes the API refuse register, contact and password-reset requests (403 captcha failed).
# Dashboard: Turnstile → the widget → Hostname Management must list adoptierlieber.de,
# www.adoptierlieber.de and staging.adoptierlieber.de, plus localhost to use the real key locally.
# Cloudflare's test keys work on any host without dashboard setup (pair site key and secret; the
# dummy widget's token is XXXX.DUMMY.TOKEN.XXXX):
#   always passes: site key 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
#   always fails:  site key 2x00000000000000000000AB, secret 2x0000000000000000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=
SECRET_TURNSTILE_SECRET=
